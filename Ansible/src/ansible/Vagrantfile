# -*- mode: ruby -*-
# vi: set ft=ruby :


Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64"
  config.vm.provider "virtualbox" do |vb|
        vb.memory = 4096
        vb.cpus = 2
    end
   
  config.vm.define "manager" do |manager|
    manager.vm.hostname = "manager"
    manager.vm.network "private_network", ip: "192.168.56.10"
    manager.vm.synced_folder "services", "/home/vagrant/services"
    #manager.vm.synced_folder "ansible", "/home/vagrant/ansible"
    end
    
  config.vm.define "node01" do |node|
    node.vm.hostname = "node01"
    node.vm.network "private_network", ip: "192.168.56.11"
    node.vm.network "forwarded_port", guest: 8081,  host: 8081,  auto_correct: true
    node.vm.network "forwarded_port", guest: 8087,  host: 8087,  auto_correct: true
    end
    
  config.vm.define "node02" do |node|
    node.vm.hostname = "node02"
    node.vm.network "private_network", ip: "192.168.56.12"
    node.vm.network "forwarded_port", guest: 80, host: 8080    # Apache
    node.vm.network "forwarded_port", guest: 5432, host: 5433  # PostgreSQL
    end
end
